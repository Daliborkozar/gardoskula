---
import Layout from '../layouts/Layout.astro';
import { translations } from '../data/translations.js';

const t = translations.en;
const googleMapsUrl = 'https://www.google.com/maps/search/?api=1&query=Millennium+Tower+Gardo%C5%A1+Hill+Zemun+Serbia';
---

<Layout title={t.visit.title} description={t.meta.description}>
  <style>
    .content {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 1rem;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
      margin: 2rem 0;
    }

    .info-card {
      background: linear-gradient(135deg, var(--light-bg), white);
      padding: 1.75rem;
      border-radius: 16px;
      border-left: 4px solid var(--primary-color);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .info-card h2,
    .info-card h3 {
      color: var(--accent-color);
    }

    .opening-details {
      white-space: pre-line;
    }

    .price-list {
      list-style: none;
      padding: 0;
    }

    .price-list li {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid rgba(196, 30, 58, 0.1);
    }

    .price {
      color: var(--accent-color);
      font-weight: 700;
    }
  </style>

  <div class="content">
    <h1>{t.siteName}</h1>

    <div class="info-grid">
      <div class="info-card">
        <h2>{t.visit.openingHeading}</h2>
        <p class="opening-details">{t.visit.openingDetails}</p>
        <p>{t.visit.weatherNote}</p>
      </div>

      <div class="info-card">
        <h2>{t.visit.admissionHeading}</h2>
        <ul class="price-list">
          {t.visit.admissionDetails.map((item) => (
            <li><span>{item.label}</span><span class="price">{item.value}</span></li>
          ))}
        </ul>
        <p>{t.visit.ageNote}</p>
      </div>

      <div class="info-card">
        <h2>{t.visit.locationHeading}</h2>
        <p>{t.visit.locationText}</p>
        <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer">{t.visit.mapLink}</a>
      </div>
    </div>

    <h2>{t.visit.travelHeading}</h2>
    <p>{t.visit.travelText}</p>
    <p><a href={googleMapsUrl} target="_blank" rel="noopener noreferrer">{t.visit.mapLink}</a></p>

    <h2>{t.visit.activitiesHeading}</h2>
    <div class="info-grid">
      {t.visit.activities.map((item) => (
        <div class="info-card">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>

    <div class="info-card">
      <h2>{t.visit.contactHeading}</h2>
      <p><a href="tel:+38163250133">{t.visit.phone}</a></p>
      <p><a href={`mailto:${t.visit.email}`}>{t.visit.email}</a></p>
      <p><a href={t.visit.website} target="_blank" rel="noopener noreferrer">www.gardos.rs</a></p>
      <p>{t.visit.address}</p>
    </div>

    <h2>{t.visit.openingHeading}</h2>
    <p class="opening-details">{t.visit.openingDetails}</p>
  </div>
</Layout>
