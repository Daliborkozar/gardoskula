---
import Layout from '../layouts/Layout.astro';
import { translations } from '../data/translations.js';

const t = translations.en;
---

<Layout title={t.about.title} description={t.meta.description}>
  <style>
    .content {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 1rem;
    }

    .facts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
      margin: 3rem 0;
      background-color: var(--light-bg);
      padding: 2rem;
      border-radius: 16px;
    }

    .fact-box {
      text-align: center;
    }

    .fact-number {
      font-size: 2rem;
      color: var(--accent-color);
      font-weight: bold;
    }

    .fact-label {
      color: var(--text-light);
      margin-top: 0.5rem;
    }

    .timeline-item {
      display: flex;
      gap: 2rem;
      margin: 1.5rem 0;
    }

    .timeline-year {
      color: var(--accent-color);
      font-weight: bold;
      min-width: 5rem;
    }

    @media (max-width: 768px) {
      .timeline-item {
        flex-direction: column;
        gap: 0.5rem;
      }
    }
  </style>

  <div class="content">
    <h1>{t.about.title}</h1>
    <h2>{t.about.historyHeading}</h2>
    <p>{t.about.historyIntro1}</p>
    <p>{t.about.historyIntro2}</p>

    <div class="facts-grid">
      {t.about.facts.map((fact) => (
        <div class="fact-box">
          <div class="fact-number">{fact.number}</div>
          <div class="fact-label">{fact.label}</div>
        </div>
      ))}
    </div>

    <h2>{t.about.timelineHeading}</h2>
    {t.about.timeline.map((item) => (
      <div class="timeline-item">
        <div class="timeline-year">{item.year}</div>
        <div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      </div>
    ))}

    <h2>{t.about.architectureHeading}</h2>
    <p>{t.about.architectureText}</p>
  </div>
</Layout>
