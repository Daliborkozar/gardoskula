---
import Layout from '../../layouts/Layout.astro';
import { locales, translations } from '../../data/translations.js';

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang ?? 'en';
const t = translations[lang] ?? translations.en;
---

<Layout locale={lang} title={t.gallery.title} description={t.meta.description}>
  <style>
    .content {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 1rem;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
      margin: 2rem 0;
    }

    .gallery-item {
      position: relative;
      overflow: hidden;
      border-radius: 18px;
      min-height: 260px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 1.5rem;
      color: white;
      background-size: cover;
      background-position: center;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
      transition: transform 0.3s ease;
    }

    .gallery-item:hover {
      transform: scale(1.03);
    }

    .gallery-item::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0.05), rgba(0,0,0,0.55));
    }

    .gallery-content {
      position: relative;
      z-index: 1;
      text-align: center;
    }

    .gallery-content h3 {
      margin-bottom: 0.5rem;
    }

    .categories {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      justify-content: center;
      margin-bottom: 1.5rem;
    }

    .category-btn {
      background-color: var(--light-bg);
      border: 1px solid var(--primary-color);
      color: var(--secondary-color);
      padding: 0.65rem 1rem;
      border-radius: 999px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .gallery-description {
      margin-top: 2rem;
      color: var(--text-light);
      line-height: 1.8;
    }

    @media (max-width: 768px) {
      .gallery-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="content">
    <h1>{t.gallery.title}</h1>
    <p>{t.gallery.subtitle}</p>

    <div class="categories">
      <div class="category-btn">{t.gallery.categories.all}</div>
      <div class="category-btn">{t.gallery.categories.fortress}</div>
      <div class="category-btn">{t.gallery.categories.views}</div>
      <div class="category-btn">{t.gallery.categories.sunset}</div>
      <div class="category-btn">{t.gallery.categories.interior}</div>
    </div>

    <div class="gallery-grid">
      {t.gallery.items.map((item) => (
        <div class="gallery-item" style={`background: linear-gradient(180deg, rgba(44,24,16,0.25), rgba(0,0,0,0.35)), linear-gradient(135deg, var(--primary-color), var(--accent-color));`}>
          <div class="gallery-content">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="gallery-description">{t.gallery.shareText}</p>
  </div>
</Layout>
