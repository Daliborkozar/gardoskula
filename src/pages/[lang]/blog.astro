---
import Layout from '../../layouts/Layout.astro';
import { locales, translations } from '../../data/translations.js';

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang ?? 'en';
const t = translations[lang] ?? translations.en;
---

<Layout locale={lang} title={t.blog.title} description={t.blog.message}>
  <section class="blog-page">
    <h1>{t.blog.title}</h1>
    <p>{t.blog.message}</p>
  </section>
</Layout>

<style>
  .blog-page {
    min-height: 45vh;
    max-width: 1100px;
    margin: 2rem auto 0;
    padding: 5rem 1rem;
    display: grid;
    align-content: center;
    text-align: center;
    background:
      linear-gradient(rgba(34, 12, 2, 0.55), rgba(34, 12, 2, 0.55)),
      url('/images/gardos-facebook-cover.jpg') center 35% / cover;
    border-radius: 16px;
  }

  .blog-page h1,
  .blog-page p {
    color: white;
  }
</style>
