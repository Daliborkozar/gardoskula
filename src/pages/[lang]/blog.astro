---
import Layout from '../../layouts/Layout.astro';
import ExhibitionGallery from '../../components/ExhibitionGallery.astro';
import { locales, translations } from '../../data/translations.js';

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang ?? 'en';
const t = translations[lang] ?? translations.en;
---

<Layout locale={lang} title={t.blog.title} description={`${t.blog.title} - ${t.siteName}`}>
  <section class="exhibitions-page">
    <h1>{t.blog.title}</h1>
    <ExhibitionGallery title={t.blog.title} />
  </section>
</Layout>

<style>
  .exhibitions-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  .exhibitions-page h1 {
    text-align: center;
    text-transform: capitalize;
  }
</style>
