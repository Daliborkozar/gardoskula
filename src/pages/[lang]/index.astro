---
import Layout from '../../layouts/Layout.astro';
import { locales, translations } from '../../data/translations.js';

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang ?? 'en';
const t = translations[lang] ?? translations.en;
---

<Layout locale={lang} title={t.meta.title} description={t.meta.description}>
  <style>
    .hero {
      background: linear-gradient(135deg, rgba(44, 24, 16, 0.8), rgba(196, 30, 58, 0.8)),
        url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600"><rect fill="%232c1810" width="1200" height="600"/></svg>');
      background-size: cover;
      background-position: center;
      color: white;
      padding: 5rem 1rem 4rem;
      min-height: 480px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .hero h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.35);
    }

    .hero p {
      font-size: 1.25rem;
      margin-bottom: 2rem;
      max-width: 760px;
      line-height: 1.8;
      color: rgba(255, 255, 255, 0.95);
    }

    .hero .btn {
      background-color: var(--primary-color);
      color: var(--secondary-color);
      font-weight: 700;
      padding: 1rem 2rem;
      border-radius: 999px;
    }

    .content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 1rem;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.75rem;
      margin-top: 2.5rem;
    }

    .feature-card {
      background-color: var(--light-bg);
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
      transition: transform 0.3s ease;
    }

    .feature-card:hover {
      transform: translateY(-4px);
    }

    .feature-card .icon {
      font-size: 2.25rem;
      margin-bottom: 1rem;
    }

    .feature-card h3 {
      margin-bottom: 0.75rem;
    }

    .section-alt {
      background-color: var(--light-bg);
      padding: 3rem 1rem;
    }

    .cta {
      text-align: center;
      background: linear-gradient(135deg, var(--secondary-color), var(--accent-color));
      color: white;
      padding: 3rem 1rem;
      border-radius: 16px;
      margin-top: 3rem;
    }

    .cta h2 {
      margin-bottom: 1rem;
    }

    @media (max-width: 768px) {
      .hero {
        padding: 3.5rem 1rem;
      }

      .hero h1 {
        font-size: 2.2rem;
      }

      .hero p {
        font-size: 1rem;
      }
    }
  </style>

  <div class="hero">
    <h1>{t.home.heroTitle}</h1>
    <p>{t.home.heroSubtitle}</p>
    <a class="btn" href={`/${lang}/visit`}>{t.home.visitButton}</a>
  </div>

  <div class="content">
    <h2>{t.home.aboutHeading}</h2>
    <p>{t.home.aboutIntro1}</p>
    <p>{t.home.aboutIntro2}</p>
  </div>

  <div class="section-alt">
    <div class="content">
      <h2>{t.home.whyHeading}</h2>
      <div class="features">
        {t.home.features.map((feature) => (
          <div class="feature-card">
            <div class="icon">{feature.icon}</div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="cta">
    <h2>{t.home.ctaHeading}</h2>
    <p>{t.home.ctaText}</p>
    <a class="btn" href={`/${lang}/visit`}>{t.home.visitButton}</a>
  </div>
</Layout>
