---
import Layout from '../../layouts/Layout.astro';
import { locales, translations } from '../../data/translations.js';

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang ?? 'en';
const t = translations[lang] ?? translations.en;
---

<Layout locale={lang} title={t.meta.title} description={t.meta.description}>
  <style>
    .hero {
      background: linear-gradient(135deg, rgba(34, 12, 2, 0.55), rgba(106, 38, 4, 0.32)),
        url('/images/gardos-facebook-cover.jpg');
      background-size: cover;
      background-position: center 35%;
      color: white;
      padding: 5rem 1rem 4rem;
      min-height: clamp(480px, 40vw, 720px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .hero h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
      color: white;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.35);
    }

    .hero p {
      font-size: 1.25rem;
      margin-bottom: 2rem;
      max-width: 760px;
      line-height: 1.8;
      color: rgba(255, 255, 255, 0.95);
    }

    .hero .btn {
      background-color: var(--primary-color);
      color: var(--secondary-color);
      font-weight: 700;
      padding: 1rem 2rem;
      border-radius: 999px;
    }

    .content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 1rem;
    }

    .cta {
      text-align: center;
      background: linear-gradient(135deg, var(--secondary-color), var(--accent-color));
      color: white;
      padding: 3rem 1rem;
      border-radius: 16px;
      margin-top: 3rem;
    }

    .cta h2 {
      margin-bottom: 1rem;
      color: var(--primary-color);
      border-color: var(--primary-color);
    }

    .cta p {
      color: rgba(255, 255, 255, 0.9);
    }

    .cta .btn {
      background-color: var(--primary-color);
      color: var(--secondary-color);
    }

    .home-gallery {
      max-width: 1200px;
      margin: 1.5rem auto 0;
      padding: 0 1rem;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .home-gallery a {
      display: block;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: var(--light-bg);
    }

    .home-gallery img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .home-gallery a:hover img {
      transform: scale(1.04);
    }

    .home-gallery a:focus-visible {
      outline: 3px solid var(--accent-color);
      outline-offset: 3px;
    }

    @media (max-width: 768px) {
      .home-gallery {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .home-gallery a:last-child {
        grid-column: span 2;
        aspect-ratio: 2 / 1;
      }

      .hero {
        padding: 3.5rem 1rem;
      }

      .hero h1 {
        font-size: 2.2rem;
      }

      .hero p {
        font-size: 1rem;
      }
    }
  </style>

  <div class="hero">
    <h1>{t.home.heroTitle}</h1>
    <p>{t.home.heroSubtitle}</p>
    <a class="btn" href={`/${lang}/visit`}>{t.home.visitButton}</a>
  </div>

  <div class="content">
    <h2>{t.home.aboutHeading}</h2>
    <p>{t.home.aboutIntro1}</p>
    <p>{t.home.aboutIntro2}</p>
  </div>

  <div class="cta">
    <h2>{t.home.ctaHeading}</h2>
    <div class="home-gallery" aria-label={t.gallery.title}>
      <a href={`/${lang}/gallery`} aria-label="Aerial view of the Millennium Tower">
        <img src="/images/gallery/DJI_0005.jpg" alt="The Millennium Tower above the rooftops in morning fog" loading="lazy" />
      </a>
      <a href={`/${lang}/gallery`} aria-label="Sunset view of the Millennium Tower">
        <img src="/images/gallery/WE7N9625.jpg" alt="Sunset over Zemun viewed from the Millennium Tower" loading="lazy" />
      </a>
      <a href={`/${lang}/gallery`} aria-label="Winter view of the Millennium Tower">
        <img src="/images/gallery/Zemun%20500x400mm.jpg" alt="The Millennium Tower on a snowy winter day" loading="lazy" />
      </a>
    </div>
  </div>
</Layout>
