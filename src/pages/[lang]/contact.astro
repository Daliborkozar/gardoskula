---
import Layout from '../../layouts/Layout.astro';
import { locales, translations } from '../../data/translations.js';

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang ?? 'en';
const t = translations[lang] ?? translations.en;
---

<Layout locale={lang} title={t.contact.title} description={t.meta.description}>
  <style>
    .content {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 1rem;
    }

    .contact-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      margin-top: 2rem;
    }

    .info-section {
      background-color: var(--light-bg);
      padding: 2rem;
      border-radius: 16px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

    .location-map {
      min-height: 520px;
      overflow: hidden;
      border-radius: 16px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

    .location-map iframe {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 520px;
      border: 0;
    }

    .info-section h3 {
      margin-top: 0;
      color: var(--primary-color);
    }

    .contact-detail-grid {
      display: grid;
      gap: 1rem;
      margin-top: 1rem;
    }

    .contact-detail {
      padding: 1rem;
      background-color: white;
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    }

    .contact-detail strong {
      display: block;
      margin-bottom: 0.5rem;
      color: var(--accent-color);
    }

    .faq {
      margin-top: 2rem;
      background-color: var(--light-bg);
      padding: 2rem;
      border-radius: 16px;
    }

    .faq-item {
      margin-bottom: 1.5rem;
    }

    .faq-item h4 {
      margin-bottom: 0.5rem;
      color: var(--secondary-color);
    }

    .faq-item p {
      margin: 0;
      color: var(--text-light);
      line-height: 1.8;
    }

    @media (max-width: 968px) {
      .contact-container {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="content">
    <h1>{t.contact.title}</h1>
    <p>{t.contact.subtitle}</p>

    <div class="contact-container">
      <div class="location-map">
        <iframe
          src="https://www.google.com/maps?q=Kula+Gardo%C5%A1%2C+Zemun%2C+Belgrade%2C+Serbia&output=embed"
          title="Google Maps location of Kula Gardoš"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <div>
        <div class="info-section">
          <h3>{t.contact.locationHeading}</h3>
          <p>Gardos Hill</p>
          <p>Grobljanska bb</p>
          <p>Zemun, Belgrade</p>
          <p>Serbia</p>
        </div>

        <div class="info-section">
          <h3>{t.contact.contactHeading}</h3>
          <div class="contact-detail-grid">
            <div class="contact-detail">
              <strong>📞</strong>
              <p>{t.contact.phone}</p>
            </div>
            <div class="contact-detail">
              <strong>✉️</strong>
              <p>{t.contact.email}</p>
            </div>
            <div class="contact-detail">
              <strong>🌐</strong>
              <p>{t.contact.website}</p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="faq">
      <h2>{t.contact.faqHeading}</h2>
      {t.contact.faq.map((item) => (
        <div class="faq-item">
          <h4>❓ {item.question}</h4>
          <p>{item.answer}</p>
        </div>
      ))}
    </div>
  </div>
</Layout>
