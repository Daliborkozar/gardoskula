---
import Layout from '../../layouts/Layout.astro';
import { locales, translations } from '../../data/translations.js';

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang ?? 'en';
const t = translations[lang] ?? translations.en;
---

<Layout locale={lang} title={t.contact.title} description={t.meta.description}>
  <style>
    .content {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 1rem;
    }

    .contact-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      margin-top: 2rem;
    }

    .contact-form,
    .info-section {
      background-color: var(--light-bg);
      padding: 2rem;
      border-radius: 16px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    label {
      display: block;
      margin-bottom: 0.6rem;
      font-weight: 600;
      color: var(--secondary-color);
    }

    input,
    textarea,
    select {
      width: 100%;
      padding: 0.85rem;
      border: 1px solid var(--primary-color);
      border-radius: 10px;
      font-family: inherit;
      font-size: 1rem;
    }

    textarea {
      min-height: 140px;
      resize: vertical;
    }

    .form-submit {
      width: 100%;
      background-color: var(--accent-color);
      color: white;
      border: none;
      padding: 1rem;
      border-radius: 10px;
      font-weight: 700;
      cursor: pointer;
      transition: background-color 0.25s ease;
    }

    .form-submit:hover {
      background-color: var(--primary-color);
    }

    .info-section h3 {
      margin-top: 0;
      color: var(--primary-color);
    }

    .contact-detail-grid {
      display: grid;
      gap: 1rem;
      margin-top: 1rem;
    }

    .contact-detail {
      padding: 1rem;
      background-color: white;
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    }

    .contact-detail strong {
      display: block;
      margin-bottom: 0.5rem;
      color: var(--accent-color);
    }

    .faq {
      margin-top: 2rem;
      background-color: var(--light-bg);
      padding: 2rem;
      border-radius: 16px;
    }

    .faq-item {
      margin-bottom: 1.5rem;
    }

    .faq-item h4 {
      margin-bottom: 0.5rem;
      color: var(--secondary-color);
    }

    .faq-item p {
      margin: 0;
      color: var(--text-light);
      line-height: 1.8;
    }

    @media (max-width: 968px) {
      .contact-container {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="content">
    <h1>{t.contact.title}</h1>
    <p>{t.contact.subtitle}</p>

    <div class="contact-container">
      <form class="contact-form" method="POST" action="https://formspree.io/f/YOUR_ID">
        <h2>{t.contact.formHeading}</h2>

        <div class="form-group">
          <label for="name">{t.contact.nameLabel}</label>
          <input type="text" id="name" name="name" required />
        </div>

        <div class="form-group">
          <label for="email">{t.contact.emailLabel}</label>
          <input type="email" id="email" name="email" required />
        </div>

        <div class="form-group">
          <label for="phone">{t.contact.phoneLabel}</label>
          <input type="tel" id="phone" name="phone" />
        </div>

        <div class="form-group">
          <label for="subject">{t.contact.subjectLabel}</label>
          <select id="subject" name="subject" required>
            <option value="">{t.contact.subjectOptions.general}</option>
            <option value="general">{t.contact.subjectOptions.general}</option>
            <option value="group">{t.contact.subjectOptions.group}</option>
            <option value="feedback">{t.contact.subjectOptions.feedback}</option>
            <option value="event">{t.contact.subjectOptions.event}</option>
            <option value="other">{t.contact.subjectOptions.other}</option>
          </select>
        </div>

        <div class="form-group">
          <label for="message">{t.contact.messageLabel}</label>
          <textarea id="message" name="message" required></textarea>
        </div>

        <button type="submit" class="form-submit">{t.contact.submitButton}</button>
      </form>

      <div>
        <div class="info-section">
          <h3>{t.contact.locationHeading}</h3>
          <p>Gardos Hill</p>
          <p>Grobljanska bb</p>
          <p>Zemun, Belgrade</p>
          <p>Serbia</p>
        </div>

        <div class="info-section">
          <h3>{t.contact.contactHeading}</h3>
          <div class="contact-detail-grid">
            <div class="contact-detail">
              <strong>📞</strong>
              <p>{t.contact.phone}</p>
            </div>
            <div class="contact-detail">
              <strong>✉️</strong>
              <p>{t.contact.email}</p>
            </div>
            <div class="contact-detail">
              <strong>🌐</strong>
              <p>{t.contact.website}</p>
            </div>
          </div>
        </div>

        <div class="info-section">
          <h3>{t.contact.hoursHeading}</h3>
          <p>Summer: 8:00 - 20:00</p>
          <p>Winter: 9:00 - 17:00</p>
        </div>
      </div>
    </div>

    <div class="faq">
      <h2>{t.contact.faqHeading}</h2>
      {t.contact.faq.map((item) => (
        <div class="faq-item">
          <h4>❓ {item.question}</h4>
          <p>{item.answer}</p>
        </div>
      ))}
    </div>
  </div>
</Layout>
