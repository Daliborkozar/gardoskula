---
import Layout from '../../layouts/Layout.astro';
import { locales, translations } from '../../data/translations.js';

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang ?? 'en';
const t = translations[lang] ?? translations.en;
---

<Layout locale={lang} title={t.visit.title} description={t.meta.description}>
  <style>
    .content {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 1rem;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.75rem;
      margin: 2rem 0;
    }

    .info-card {
      background: linear-gradient(135deg, var(--light-bg), white);
      padding: 2rem;
      border-radius: 16px;
      border-left: 4px solid var(--primary-color);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

    .info-card h3 {
      margin-top: 0;
      color: var(--accent-color);
    }

    .tip-box {
      background-color: #e8f4f8;
      border-left: 4px solid var(--accent-color);
      padding: 1.5rem;
      margin: 2rem 0;
      border-radius: 10px;
    }

    .contact-details {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }

    .contact-item {
      padding: 1rem;
      background-color: white;
      border-radius: 10px;
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.07);
    }

    .contact-item strong {
      display: block;
      color: var(--accent-color);
      margin-bottom: 0.5rem;
    }

    .price-list {
      list-style: none;
      padding: 0;
      margin: 1rem 0 0;
    }

    .price-list li {
      display: flex;
      justify-content: space-between;
      padding: 0.75rem 0;
      border-bottom: 1px solid rgba(196, 30, 58, 0.1);
    }

    .price-list li:last-child {
      border-bottom: none;
    }

    .price {
      color: var(--accent-color);
      font-weight: 700;
    }

    @media (max-width: 768px) {
      .info-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="content">
    <h1>{t.visit.title}</h1>

    <div class="info-grid">
      <div class="info-card">
        <h3>{t.visit.openingHeading}</h3>
        <p>{t.visit.openingDetails}</p>
      </div>

      <div class="info-card">
        <h3>{t.visit.admissionHeading}</h3>
        <ul class="price-list">
          {t.visit.admissionDetails.map((item) => (
            <li>
              <span>{item.label}</span>
              <span class="price">{item.value}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="info-card">
        <h3>{t.visit.locationHeading}</h3>
        <p>{t.visit.locationText}</p>
      </div>
    </div>

    <h2>{t.visit.travelHeading}</h2>
    <p>{t.visit.travelText}</p>

    <div class="tip-box">
      <strong>💡</strong> {t.visit.tipsText}
    </div>

    <h2>{t.visit.activitiesHeading}</h2>
    <div class="info-grid">
      {t.visit.activities.map((item) => (
        <div class="info-card">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>

    <h2>{t.visit.guidelinesHeading}</h2>
    <ul style="margin-left: 1.5rem; color: var(--text-light); line-height: 1.9;">
      {t.visit.guidelines.map((rule) => (
        <li>{rule}</li>
      ))}
    </ul>

    <div class="tip-box">
      <strong>⚠️</strong> {t.visit.note}
    </div>

    <div class="contact-item" style="margin-top:2rem; background-color: var(--light-bg);">
      <h3>{t.visit.contactHeading}</h3>
      <div class="contact-details">
        <div class="contact-item">
          <strong>📞</strong>
          <p>{t.visit.phone}</p>
        </div>
        <div class="contact-item">
          <strong>✉️</strong>
          <p>{t.visit.email}</p>
        </div>
        <div class="contact-item">
          <strong>🌐</strong>
          <p>{t.visit.website}</p>
        </div>
        <div class="contact-item">
          <strong>📍</strong>
          <p>{t.visit.address}</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
