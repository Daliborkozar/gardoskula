---
import Layout from '../layouts/Layout.astro';
import { galleryImages } from '../data/galleryImages.js';

const captions = [
  'Fortress Exterior',
  'Tower Architecture',
  'Fortress Detail',
  'Danube Panorama',
  'City Skyline',
  'Garden Views',
  'Golden Hour',
  'Danube Sunset',
  'Evening Lights',
  'Historical Exhibits',
  'Tower Interior',
  'Cultural Displays',
];

const galleryItems = galleryImages.map((image, index) => ({ image, caption: captions[index] }));
---

<Layout 
  title="Gallery"
  description="View stunning photos of Kula Gardos fortress, its architecture, and panoramic views"
>
  <style>
    .content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 1rem;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
      margin: 2rem 0;
    }

    .gallery-item {
      position: relative;
      overflow: hidden;
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
      transition: transform 0.3s ease;
      background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
      aspect-ratio: 3/2;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      text-align: center;
    }

    .gallery-item::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 35%, rgba(0, 0, 0, 0.65));
    }

    .gallery-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .gallery-item:hover {
      transform: scale(1.05);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
    }

    @media (max-width: 768px) {
      .gallery-grid {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      }
    }
  </style>

  <div class="content">
    <h1>Gallery</h1>
    <p>
      Explore the beauty and grandeur of Kula Gardos through our collection of photos showcasing 
      the fortress from every angle and throughout different seasons.
    </p>

    <div class="gallery-grid">
      {galleryItems.map(({ image, caption }, index) => (
        <div class="gallery-item">
          <img class="gallery-image" src={`/images/gallery/${encodeURIComponent(image)}`} alt={caption ?? `Kula Gardos photo ${index + 1}`} loading="lazy" />
        </div>
      ))}
    </div>

    <h2 style="margin-top: 4rem;">Share Your Photos</h2>
    <p>
      Have you visited Kula Gardos and captured amazing photos? We'd love to see them! 
      Send your best pictures to <strong>info@gardos.rs</strong> with permission to display them 
      in our gallery, and we'll credit your work.
    </p>
  </div>

</Layout>
