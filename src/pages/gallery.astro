---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Gallery"
  description="View stunning photos of Kula Gardos fortress, its architecture, and panoramic views"
>
  <style>
    .content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 1rem;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
      margin: 2rem 0;
    }

    .gallery-item {
      position: relative;
      overflow: hidden;
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
      transition: transform 0.3s ease;
      background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
      aspect-ratio: 3/2;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      text-align: center;
      padding: 1rem;
    }

    .gallery-item:hover {
      transform: scale(1.05);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
    }

    .gallery-item.fortress {
      background: linear-gradient(135deg, rgba(212, 165, 116, 0.8), rgba(196, 30, 58, 0.8)), 
                  url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300"><rect fill="%23d4a574" width="400" height="300"/><rect fill="%23c41e3a" x="50" y="50" width="300" height="200" opacity="0.3"/></svg>');
      background-size: cover;
    }

    .gallery-item.views {
      background: linear-gradient(135deg, rgba(44, 24, 16, 0.8), rgba(212, 165, 116, 0.8)),
                  url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300"><rect fill="%232c1810" width="400" height="100"/><rect fill="%2385bce5" y="100" width="400" height="200"/></svg>');
      background-size: cover;
    }

    .gallery-item.sunset {
      background: linear-gradient(135deg, rgba(196, 30, 58, 0.8), rgba(212, 165, 116, 0.8)),
                  url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300"><rect fill="%23ff6b35" y="100" width="400" height="100"/><rect fill="%23f7931e" width="400" height="100"/><rect fill="%231a1a1a" y="200" width="400" height="100"/></svg>');
      background-size: cover;
    }

    .gallery-item.interior {
      background: linear-gradient(135deg, rgba(44, 24, 16, 0.9), rgba(212, 165, 116, 0.9)),
                  url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300"><rect fill="%232c1810" width="400" height="300"/><circle cx="200" cy="150" r="50" fill="%23d4a574" opacity="0.3"/></svg>');
      background-size: cover;
    }

    .gallery-categories {
      display: flex;
      gap: 1rem;
      margin: 2rem 0;
      flex-wrap: wrap;
      justify-content: center;
    }

    .category-btn {
      background-color: var(--light-bg);
      border: 2px solid var(--primary-color);
      color: var(--text-dark);
      padding: 0.5rem 1.5rem;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.3s ease;
      font-weight: 500;
    }

    .category-btn:hover,
    .category-btn.active {
      background-color: var(--accent-color);
      color: white;
      border-color: var(--accent-color);
    }

    .image-description {
      font-size: 0.9rem;
      margin-top: 0.5rem;
      font-weight: normal;
    }

    @media (max-width: 768px) {
      .gallery-grid {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      }
    }
  </style>

  <div class="content">
    <h1>Gallery</h1>
    <p>
      Explore the beauty and grandeur of Kula Gardos through our collection of photos showcasing 
      the fortress from every angle and throughout different seasons.
    </p>

    <div class="gallery-categories">
      <button class="category-btn active" onclick="filterGallery('all')">All Photos</button>
      <button class="category-btn" onclick="filterGallery('fortress')">Fortress</button>
      <button class="category-btn" onclick="filterGallery('views')">Views</button>
      <button class="category-btn" onclick="filterGallery('sunset')">Sunset</button>
      <button class="category-btn" onclick="filterGallery('interior')">Interior</button>
    </div>

    <div class="gallery-grid" id="galleryGrid">
      <!-- Fortress Category -->
      <div class="gallery-item fortress" data-category="fortress">
        <div>
          <div>🏰 Fortress Exterior</div>
          <div class="image-description">Classic view of the yellow fortress</div>
        </div>
      </div>

      <div class="gallery-item fortress" data-category="fortress">
        <div>
          <div>🏗️ Tower Architecture</div>
          <div class="image-description">Detailed Austro-Hungarian architecture</div>
        </div>
      </div>

      <div class="gallery-item fortress" data-category="fortress">
        <div>
          <div>🎨 Fortress Detail</div>
          <div class="image-description">Architectural decorative elements</div>
        </div>
      </div>

      <!-- Views Category -->
      <div class="gallery-item views" data-category="views">
        <div>
          <div>🌍 Danube Panorama</div>
          <div class="image-description">Sweeping view of the Danube</div>
        </div>
      </div>

      <div class="gallery-item views" data-category="views">
        <div>
          <div>🏙️ City Skyline</div>
          <div class="image-description">Belgrade and surrounding landscape</div>
        </div>
      </div>

      <div class="gallery-item views" data-category="views">
        <div>
          <div>🌳 Garden Views</div>
          <div class="image-description">Natural surroundings of Gardos Hill</div>
        </div>
      </div>

      <!-- Sunset Category -->
      <div class="gallery-item sunset" data-category="sunset">
        <div>
          <div>🌅 Golden Hour</div>
          <div class="image-description">Fortress during sunset</div>
        </div>
      </div>

      <div class="gallery-item sunset" data-category="sunset">
        <div>
          <div>🌇 Danube Sunset</div>
          <div class="image-description">River reflecting evening light</div>
        </div>
      </div>

      <div class="gallery-item sunset" data-category="sunset">
        <div>
          <div>🌙 Evening Lights</div>
          <div class="image-description">Fortress illuminated at dusk</div>
        </div>
      </div>

      <!-- Interior Category -->
      <div class="gallery-item interior" data-category="interior">
        <div>
          <div>📜 Historical Exhibits</div>
          <div class="image-description">Museum exhibits and artifacts</div>
        </div>
      </div>

      <div class="gallery-item interior" data-category="interior">
        <div>
          <div>🪟 Tower Interior</div>
          <div class="image-description">Interior tower space</div>
        </div>
      </div>

      <div class="gallery-item interior" data-category="interior">
        <div>
          <div>🎭 Cultural Displays</div>
          <div class="image-description">Information and cultural panels</div>
        </div>
      </div>
    </div>

    <h2 style="margin-top: 4rem;">Share Your Photos</h2>
    <p>
      Have you visited Kula Gardos and captured amazing photos? We'd love to see them! 
      Send your best pictures to <strong>info@gardos.rs</strong> with permission to display them 
      in our gallery, and we'll credit your work.
    </p>
  </div>

  <script>
    function filterGallery(category) {
      const items = document.querySelectorAll('.gallery-item');
      const buttons = document.querySelectorAll('.category-btn');

      // Update active button
      buttons.forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');

      // Filter items
      items.forEach(item => {
        if (category === 'all') {
          item.style.display = '';
        } else {
          item.style.display = item.getAttribute('data-category') === category ? '' : 'none';
        }
      });
    }
  </script>
</Layout>
