---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact"
  description="Get in touch with Kula Gardos for inquiries, group bookings, or feedback"
>
  <style>
    .content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 1rem;
    }

    .contact-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      margin: 2rem 0;
    }

    .location-map {
      min-height: 520px;
      overflow: hidden;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .location-map iframe {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 520px;
      border: 0;
    }

    .contact-info {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .info-section {
      background: linear-gradient(135deg, var(--secondary-color), rgba(44, 24, 16, 0.8));
      color: white;
      padding: 2rem;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .info-section h3 {
      color: var(--primary-color);
      margin-top: 0;
    }

    .info-section p {
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 0.5rem;
    }

    .info-section a {
      color: var(--primary-color);
    }

    .info-section a:hover {
      color: white;
    }

    .social-links {
      display: flex;
      gap: 1rem;
      margin-top: 1rem;
    }

    .social-links a {
      display: inline-block;
      width: 40px;
      height: 40px;
      background-color: rgba(212, 165, 116, 0.3);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      transition: all 0.3s ease;
    }

    .social-links a:hover {
      background-color: var(--primary-color);
      color: var(--secondary-color);
    }

    @media (max-width: 968px) {
      .contact-container {
        grid-template-columns: 1fr;
      }
    }

    .faq {
      background-color: var(--light-bg);
      padding: 2rem;
      border-radius: 8px;
      margin: 2rem 0;
    }

    .faq-item {
      margin-bottom: 1.5rem;
    }

    .faq-item h4 {
      color: var(--accent-color);
      margin-bottom: 0.5rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .faq-item p {
      margin-bottom: 0;
      padding-left: 1.5rem;
    }
  </style>

  <div class="content">
    <h1>Contact Us</h1>
    <p>
      Have questions? Want to book a group visit? Or just want to share your experience? 
      We'd love to hear from you!
    </p>

    <div class="contact-container">
      <div class="location-map">
        <iframe
          src="https://www.google.com/maps?q=Kula+Gardo%C5%A1%2C+Zemun%2C+Belgrade%2C+Serbia&output=embed"
          title="Google Maps location of Kula Gardoš"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <div class="contact-info">
        <div class="info-section">
          <h3>📍 Location</h3>
          <p><strong>Kula Gardos</strong></p>
          <p>Gardos Hill, Grobljanska 22</p>
          <p>Zemun, Belgrade 11000</p>
          <p>Serbia</p>
        </div>

        <div class="info-section">
          <h3>📞 Contact Details</h3>
          <p><strong>Phone:</strong> <a href="tel:+38163250133">+381 63250133</a></p>
          <p><strong>Facebook:</strong> <a href="https://www.facebook.com/ZemunskakulanaGardosu/" target="_blank" rel="noopener noreferrer">Facebook page</a></p>
          <p><strong>Website:</strong> <a href="https://www.gardos.rs" target="_blank">www.gardos.rs</a></p>
        </div>

      </div>
    </div>

  </div>
</Layout>
