---
import Layout from '../layouts/Layout.astro';
import ExhibitionGallery from '../components/ExhibitionGallery.astro';
---

<Layout title="Exhibitions" description="Exhibitions at Kula Gardos.">
  <section class="exhibitions-page">
    <h1>Exhibitions</h1>
    <ExhibitionGallery title="Exhibition" />
  </section>
</Layout>

<style>
  .exhibitions-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  .exhibitions-page h1 {
    text-align: center;
    text-transform: capitalize;
  }
</style>
